# ===============================================
# Reunion site — Vercel environment variables
# Copy these to your Vercel Project → Settings → Environment Variables
# (Production AND Preview).
# ===============================================

# --- Supabase ---
# From Supabase → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_KEY=your-service-role-key   # SERVER-SIDE ONLY. Never expose.

# --- Resend (email) ---
# From resend.com → API Keys (scope: Send)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
FROM_NAME=NHS Class of 2016
FROM_EMAIL=reunion@newark2016.com

# --- Site URL ---
SITE_URL=https://newark2016.com

# --- GitHub (for the admin "Save & Publish" feature in admin.html) ---
# Fine-grained PAT with: Contents = Read & write on the reunion repo only.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
GITHUB_REPO=wisemanmax/nhs
